{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{"name": "next"}],
    "paths": {"@/*": ["./src/*"]}
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": [
    "node_modules",
    "remotion",
    // Werkzeuge, die NICHT gebuendelt werden: Sie laufen ueber Nodes
    // Typ-Entfernung (`node --experimental-strip-types`) und muessen
    // ihre Importe deshalb MIT `.ts`-Endung schreiben — was der
    // Anwendungs-Typcheck zu Recht verbietet (TS5097). Zwei
    // verschiedene Laufzeiten, zwei verschiedene Regeln.
    "scripts"
  ]
}
